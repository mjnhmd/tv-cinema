+    /**
+     * Legacy APIs return a plain list with no match confidence. Binding its first entry is how a
+     * neighbouring episode (or another show) ended up on screen. Keep only one candidate whose
+     * title and episode number both describe the requested episode; anything else stays unbound
+     * and remains available through the manual search dialog.
+     */
+    static List<Danmaku> selectExactEpisode(List<Danmaku> items, String name, String episode) {
+        if (items == null || items.isEmpty()) return List.of();
+        EpisodeLabel expected = EpisodeLabelParser.parse(episode);
+        String title = normalizeTitle(name);
+        if (!expected.isSingleEpisode() || expected.isVariety() || title.isEmpty()) return List.of();
+        List<Danmaku> matches = new ArrayList<>();
+        for (Danmaku item : items) {
+            if (item == null || item.isEmpty()) continue;
+            EpisodeLabel candidate = EpisodeLabelParser.parse(item.getName());
+            if (!candidate.isSingleEpisode() || candidate.isVariety() || !Objects.equals(candidate.number(), expected.number())) continue;
+            Integer expectedSeason = expected.season();
+            Integer candidateSeason = candidate.season();
+            if (expectedSeason != null && candidateSeason != null && !expectedSeason.equals(candidateSeason)) continue;
+            if (!titleOf(item.getName()).equals(title)) continue;
+            matches.add(item);
+            if (matches.size() > 1) return List.of();
+        }
+        return matches;
+    }
+
+    private static String normalizeTitle(String text) {
+        String value;
+        try {
+            value = Trans.t2s(false, text == null ? "" : text);
+        } catch (Throwable ignored) {
+            value = text == null ? "" : text;
+        }
+        return Normalizer.normalize(value, Normalizer.Form.NFKC).replaceAll("[^\\p{L}\\p{Nd}]", "").toLowerCase(Locale.ROOT);
+    }
+
+    private static String titleOf(String text) {
+        String value;
+        try {
+            value = Trans.t2s(false, text == null ? "" : text);
+        } catch (Throwable ignored) {
+            value = text == null ? "" : text;
+        }
+        value = Normalizer.normalize(value, Normalizer.Form.NFKC);
+        value = value.replaceAll("^\\s*(?:【[^】]*】|\\[[^\\]]*\\])\\s*", "");
+        value = value.replaceAll("(?i)\\s*(?:第\\s*)?[0-9]+\\s*[集话期回部]\\s*$", "");
+        value = value.replaceAll("(?i)\\s*S[0-9]{1,3}E[0-9]{1,3}\\s*$", "");
+        value = value.replaceAll("(?i)\\s*EP?\\.?\\s*[0-9]{1,3}\\s*$", "");
+        return value.replaceAll("[^\\p{L}\\p{Nd}]", "").toLowerCase(Locale.ROOT);
+    }
+
     public static void searchAuto(String name, String episode, Result result, SearchCallback callback) {
         searchAuto(name, episode, result, true, callback);
     }

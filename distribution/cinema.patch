     coreLibraryDesugaring libs.desugar
 }
+
+// Transform generated archives before generate*PythonBuildAssets records their SHA-1 hashes.
+gradle.projectsEvaluated {
+    tasks.matching { it.name.matches('generate.*PythonRequirementsAssets') }.each { task ->
+        task.inputs.file(layout.projectDirectory.file('trim-python-tests.py'))
+        task.doLast {
+            def trim = providers.exec {
+                commandLine 'python3', project.file('trim-python-tests.py'), task.assetDir
+                ignoreExitValue = true
+            }
+            def output = trim.standardOutput.asText.get().trim()
+            if (!output.isEmpty()) logger.lifecycle(output)
+            if (trim.result.get().exitValue != 0) {
+                throw new GradleException(trim.standardError.asText.get().trim())
+            }
+        }
+    }
+}

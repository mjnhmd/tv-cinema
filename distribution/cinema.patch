+    private void onBuiltinSources() {
+        List<CinemaSources.Entry> entries = CinemaSources.catalogEntries();
+        String[] items = new String[entries.size()];
+        for (int i = 0; i < entries.size(); i++) {
+            CinemaSources.Entry entry = entries.get(i);
+            String state = CinemaSources.isActive(entry) ? " · 当前" : CinemaSources.isAdded(entry) ? " · 已添加" : "";
+            items[i] = entry.name() + (entry.isVod() ? " · 点播" : " · 直播") + state;
+        }
+        new MaterialAlertDialogBuilder(this)
+                .setTitle(R.string.cinema_sources_catalog)
+                .setItems(items, (dialog, which) -> {
+                    Config config = CinemaSources.activate(entries.get(which));
+                    dialog.dismiss();
+                    setConfig(config);
+                })
+                .setNegativeButton(R.string.dialog_negative, null)
+                .show();
+    }
+
+    private void onDiscoverSources() {
+        MaterialAlertDialogBuilder dialog = new MaterialAlertDialogBuilder(this)
+                .setTitle(R.string.cinema_discover_sources)
+                .setMessage(R.string.cinema_discover_notice)
+                .setPositiveButton(R.string.cinema_discover_start, (ignored, which) -> startSourceDiscovery())
+                .setNegativeButton(R.string.dialog_negative, null);
+        if (CinemaDiscovery.hasCandidate()) {
+            dialog.setNeutralButton(R.string.cinema_discover_use, (ignored, which) -> onBuiltinSources());
+        }
+        dialog.show();
+    }
+
+    private void startSourceDiscovery() {
+        boolean started = CinemaDiscovery.start(new CinemaDiscovery.Listener() {
+            @Override
+            public void onFinished(CinemaSourceMerger.Result result) {
+                if (isFinishing() || isDestroyed()) return;
+                Notify.dismiss();
+                refreshSourceRows();
+                CinemaSourceMerger.Stats stats = result.stats();
+                new MaterialAlertDialogBuilder(SettingActivity.this)
+                        .setTitle(R.string.cinema_discover_done)
+                        .setMessage(getString(R.string.cinema_discover_summary, stats.validInputs,
+                                stats.inputs, stats.sitesAdded, stats.sitesDuplicate))
+                        .setPositiveButton(R.string.cinema_discover_use, (ignored, which) -> onBuiltinSources())
+                        .show();
+            }
+
+            @Override
+            public void onError() {
+                if (isFinishing() || isDestroyed()) return;
+                Notify.dismiss();
+                Notify.show(R.string.cinema_discover_failed);
+            }
+        });
+        if (started) Notify.progress(getActivity());
+        else Notify.show(R.string.cinema_discover_busy);
+    }

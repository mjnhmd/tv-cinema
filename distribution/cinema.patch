+                if (isFinishing() || isDestroyed()) return;
+                Notify.dismiss();
+                refreshSourceRows();
+                CinemaSourceMerger.Stats stats = result.stats();
+                new MaterialAlertDialogBuilder(SettingActivity.this)
+                        .setTitle(R.string.cinema_discover_done)
+                        .setMessage(getString(R.string.cinema_discover_summary, stats.validInputs,
+                                stats.inputs, stats.sitesAdded, stats.sitesDuplicate))
+                        .setPositiveButton(R.string.cinema_discover_use, (ignored, which) -> onBuiltinSources())
+                        .show();
+            }
+
+            @Override
+            public void onError() {
+                if (isFinishing() || isDestroyed()) return;
+                Notify.dismiss();
+                Notify.show(R.string.cinema_discover_failed);
+            }
+        });
+        if (started) Notify.progress(getActivity());
+        else Notify.show(R.string.cinema_discover_busy);
+    }

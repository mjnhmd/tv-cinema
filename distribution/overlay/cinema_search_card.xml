<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamVodCardRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical">

    <com.fongmi.android.tv.ui.custom.JetStreamVodPosterLayout
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:duplicateParentState="true">

        <com.fongmi.android.tv.ui.custom.JetStreamPosterImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/cinema_search_scrim"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="28dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <com.fongmi.android.tv.ui.custom.JetStreamStrongLabelTextView
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#FFD18C"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
                android:id="@+id/remark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#F5F0E8"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
            android:id="@+id/site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/cinema_search_badge"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:paddingHorizontal="7dp"
            android:paddingVertical="4dp"
            android:singleLine="true"
            android:textColor="#F5F0E8"
            android:textSize="12sp"
            android:visibility="gone" />
    </com.fongmi.android.tv.ui.custom.JetStreamVodPosterLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamStrongLabelTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="start|top"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:minLines="2"
        android:textColor="@color/jetstream_on_surface"
        android:textSize="16sp"
        android:textStyle="normal" />
</com.fongmi.android.tv.ui.custom.JetStreamVodCardRootLayout>
